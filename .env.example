# ---------- Google AI (Gemini) ----------
# Use either a Gemini API key OR Vertex AI (project + location). ADK/GenAI SDK
# picks up whichever credential you provide.
GEMINI_API_KEY=your-gemini-api-key
# Vertex AI alternative:
# GEMINI_PROJECT=your-gcp-project-id
# GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# ---------- Storage ----------
# firestore = production ledger on Cloud Firestore
# local     = JSON files, no GCP needed (great for a quick demo)
STORE_BACKEND=firestore
FIRESTORE_PROJECT=
FIRESTORE_PREFIX=atlas
LOCAL_STORE_PATH=./atlas_data

# ---------- Runtime ----------
MAX_STEPS_PER_TASK=30
MAX_TURNS_PER_STEP=8
SPRING_BATCH=5
APP_PORT=8080

# ---------- Optional integrations ----------
# If set, the web_search tool performs real searches (serpapi.com key).
SERPAPI_KEY=
